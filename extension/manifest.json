{
  "manifest_version": 3,
  "name": "WebBridge - AI File Connector (Claude, Qwen & DeepSeek)",
  "version": "1.3.1",
  "description": "Connect Claude, Qwen, and DeepSeek chat to your local files via a local bridge server",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chat.qwen.ai/*",
    "https://chat.qwenlm.ai/*",
    "https://tongyi.aliyun.com/*",
    "https://chat.deepseek.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "tool-catalogue.json"
      ],
      "matches": [
        "https://claude.ai/*",
        "https://chat.qwen.ai/*",
        "https://chat.qwenlm.ai/*",
        "https://tongyi.aliyun.com/*",
        "https://chat.deepseek.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chat.qwen.ai/*",
        "https://chat.qwenlm.ai/*",
        "https://tongyi.aliyun.com/*",
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
